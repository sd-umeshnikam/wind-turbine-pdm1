# dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# build output
dist/
build/
*.egg-info/

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# env/secrets
.env
.env.*
*.tfvars

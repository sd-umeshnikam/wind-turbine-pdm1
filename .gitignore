# large generated EDA artifacts (keep charts referenced by the report only if small; raw intermediates excluded)
eda/outputs/*.parquet
eda/outputs/*.tmp

# Word deliverable QA renders (docs/deliverables/scripts/_word_qa.py output) - regenerate, don't commit
docs/deliverables/*.pdf
docs/deliverables/*_qa_pages/

# AppSync GraphQL endpoint. Leave unset to run entirely on mock data
# (getTelemetry/getPredictions/getActiveAlerts fall back automatically, and
# subscribeToTwinUpdates is always mock-driven for now - see src/api/client.ts).
VITE_APPSYNC_URL=
VITE_APPSYNC_API_KEY=

# Branding and appearance defaults (all optional). Users can still change theme,
# accent colour, density and text size from the sidebar's Appearance panel; their
# choice is saved in the browser and wins over these defaults.
# VITE_APP_TITLE=Wind Turbine PdM
# VITE_APP_SUBTITLE=Predictive maintenance
# VITE_DEFAULT_THEME=system          # system | light | dark
# VITE_DEFAULT_ACCENT=#2563a8        # any #rrggbb colour
# VITE_DEFAULT_DENSITY=comfortable   # comfortable | compact
# VITE_DEFAULT_FONT_SCALE=default    # default | large

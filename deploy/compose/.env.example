# Copy to .env (git-ignored) and fill in. Never commit real secrets.
WTPDM_DB_PASSWORD=change-me
# Path to the raw CARE dataset on the host (mounted read-only).
WTPDM_RAW_DATA_DIR=D:/wind-turbine-scada-data-for-early-fault-detection
# API auth - required by the API. The secret needs >= 32 characters (e.g. `openssl rand -hex 32`);
# the admin is created on first start when no admin exists.
WTPDM_JWT_SECRET=generate-a-long-random-string
WTPDM_ADMIN_USERNAME=admin
WTPDM_ADMIN_PASSWORD=change-me-at-least-12-chars
# Assistant (OpenAI-compatible, e.g. Groq) - required by the assistant from P6 on.
WTPDM_LLM_API_KEY=
# Real-time worker (defaults shown). Replay speed = simulated seconds per wall-clock second.
WTPDM_REPLAY_SPEED=60
WTPDM_REPLAY_TICK_SECONDS=10
WTPDM_DRIFT_INTERVAL_MINUTES=15
WTPDM_DRIFT_WINDOW_DAYS=30
# Scheduled retrain (crontab, UTC) and promotion policy.
WTPDM_RETRAIN_CRON=0 2 * * 0
WTPDM_RETRAIN_COOLDOWN_HOURS=24
WTPDM_RETRAIN_AUTO_PROMOTE=true
# Browser-facing MLflow UI, used for run links returned by the API.
WTPDM_MLFLOW_UI_URL=http://localhost:5001
# Allowed cross-origin callers (JSON list); empty when the console is served same-origin.
WTPDM_CORS_ORIGINS=[]

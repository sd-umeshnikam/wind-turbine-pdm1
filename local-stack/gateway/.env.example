# Copy to .env (same directory) and adjust paths if you cloned the repo somewhere
# other than /opt/wtb-pdm. `npm start` (tsx) loads process.env directly - export
# these in your shell for a manual run, or use `npx dotenv -e .env -- npm start`
# / the systemd EnvironmentFile= for a persistent one.

GATEWAY_PORT=4000
SCHEDULER_INTERVAL_MS=60000

# telemetry-api local backend (TimescaleDB, see docker-compose.yml)
TELEMETRY_BACKEND=postgres
TIMESCALE_URL=postgresql://wtb_pdm:wtb_pdm_local@localhost:5433/wtb_pdm

# prediction-api -> local inference server (see ../inference/serve.py)
DATABRICKS_SERVING_URL=http://localhost:8080/invocations
DATABRICKS_SERVING_TOKEN=local-dev-token

# alerting-service -> LocalStack DynamoDB + SNS
ALERTS_TABLE_NAME=wtb-pdm-local-alerts
ALERT_CONFIG_TABLE_NAME=wtb-pdm-local-config
ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wtb-pdm-local-alerts
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Where the pipeline wrote its Delta tables + turbine_id_map.json (defaults to
# <repo>/local-stack/data-lake if unset)
# DATA_LAKE_ROOT=/opt/wtb-pdm/local-stack/data-lake

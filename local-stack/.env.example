# Copy to local-stack/.env (git-ignored) - docker compose reads it automatically.
# After changing it, apply with:  docker compose up -d chatbot   (a plain restart won't reload it)

# Groq key for the turbine assistant (console.groq.com -> API Keys). Leave the
# placeholder and the chatbot runs in retrieval-only mode (shows matching facts
# instead of a written answer).
GROQ_API_KEY=your-groq-api-key-here
# Optional overrides - any OpenAI-compatible endpoint works.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
